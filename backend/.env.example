# =====================================================================
# Trouve ton artisan - Variables d'environnement (modèle)
# Copier ce fichier vers `.env` et adapter les valeurs.
# Le fichier `.env` NE DOIT JAMAIS être commité (cf. .gitignore).
# =====================================================================

# Serveur
NODE_ENV=development
PORT=4000

# Base de données MySQL/MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trouve_ton_artisan
DB_USER=ttartisan_app
DB_PASSWORD=change_me_strong_password

# CORS : origine(s) autorisée(s), séparées par une virgule
CORS_ORIGIN=http://localhost:5173

# Clé d'API partagée entre le frontend et l'API
# Permet de restreindre l'accès à l'application (cf. brief).
API_KEY=change_me_random_long_string

# SMTP pour l'envoi des messages de contact aux artisans
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_FROM="Trouve ton artisan <no-reply@example.com>"

# Limitation de débit (rate limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_MAX=5

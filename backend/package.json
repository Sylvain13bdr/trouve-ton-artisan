    "helmet": "^7.1.0",
    "mongoose": "^9.7.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^8.0.7",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
